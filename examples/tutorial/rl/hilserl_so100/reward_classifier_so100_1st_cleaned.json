{
  "dataset": {
    "repo_id": "local/so100_reward_labels_1st_cleaned",
    "root": "data/so100_reward_labels_1st_cleaned"
  },
  "policy": {
    "type": "reward_classifier",
    "model_name": "helper2424/resnet10",
    "model_type": "cnn",
    "num_cameras": 1,
    "num_classes": 2,
    "hidden_dim": 256,
    "dropout_rate": 0.1,
    "learning_rate": 0.0001,
    "device": "cuda",
    "input_features": {
      "observation.images.naname": {
        "type": "VISUAL",
        "shape": [3, 128, 128]
      }
    },
    "push_to_hub": false
  },
  "output_dir": "outputs/so100_reward_classifier_1st_cleaned",
  "batch_size": 16,
  "num_workers": 4,
  "steps": 5000,
  "log_freq": 10,
  "save_freq": 1000,
  "save_checkpoint": true,
  "eval_freq": 0,
  "wandb": {
    "enable": true
  }
}
