{
  "dataset": {
    "repo_id": "local/so101_coffee_keyboard_demos",
    "root": "data/so101_coffee_keyboard_demos",
    "use_imagenet_stats": false
  },
  "output_dir": "outputs/so101_coffee_hilserl_sim",
  "job_name": "so101-coffee-sim",
  "resume": false,
  "seed": 1000,
  "batch_size": 32,
  "log_freq": 10,
  "save_checkpoint": true,
  "save_freq": 1000,
  "wandb": {
    "enable": false
  },
  "policy": {
    "type": "sac",
    "push_to_hub": false,
    "input_features": {
      "observation.images.front": {
        "type": "VISUAL",
        "shape": [3, 128, 128]
      },
      "observation.images.wrist": {
        "type": "VISUAL",
        "shape": [3, 128, 128]
      },
      "observation.state": {
        "type": "STATE",
        "shape": [18]
      }
    },
    "output_features": {
      "action": {
        "type": "ACTION",
        "shape": [3]
      }
    },
    "device": "cuda",
    "storage_device": "cpu",
    "vision_encoder_name": null,
    "freeze_vision_encoder": false,
    "num_discrete_actions": 3,
    "online_steps": 10000,
    "online_buffer_capacity": 50000,
    "offline_buffer_capacity": 50000,
    "online_step_before_learning": 100,
    "use_torch_compile": false,
    "actor_learner_config": {
      "learner_host": "127.0.0.1",
      "learner_port": 50051,
      "policy_parameters_push_frequency": 50
    }
  },
  "env": {
    "type": "gym_manipulator",
    "name": "gym_hil",
    "task": "SO101CoffeeKeyboard-v0",
    "fps": 10,
    "robot": null,
    "teleop": null,
    "features": {
      "observation.images.front": {
        "type": "VISUAL",
        "shape": [3, 128, 128]
      },
      "observation.images.wrist": {
        "type": "VISUAL",
        "shape": [3, 128, 128]
      },
      "observation.state": {
        "type": "STATE",
        "shape": [18]
      },
      "action": {
        "type": "ACTION",
        "shape": [3]
      }
    },
    "features_map": {
      "observation.images.front": "observation.images.front",
      "observation.images.wrist": "observation.images.wrist",
      "observation.state": "observation.state",
      "action": "action"
    },
    "processor": {
      "control_mode": "keyboard",
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": -0.02
      },
      "reset": {
        "reset_time_s": 0.0,
        "control_time_s": 30.0,
        "terminate_on_success": false
      }
    }
  }
}
