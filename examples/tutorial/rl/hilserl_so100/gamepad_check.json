{
  "env": {
    "name": "real_robot",
    "fps": 10,
    "robot": {
      "type": "so101_follower",
      "port": "/dev/ttyACM0",
      "id": "so101_follower",
      "use_degrees": true,
      "max_relative_target": 2.0,
      "cameras": {
        "front": {
          "type": "opencv",
          "index_or_path": "/dev/v4l/by-id/usb-Intel_R__RealSense_TM__Depth_Camera_435_Intel_R__RealSense_TM__Depth_Camera_435_952323020953-video-index0",
          "fps": 30,
          "width": 640,
          "height": 480
        }
      }
    },
    "teleop": {
      "type": "gamepad",
      "use_gripper": true
    },
    "processor": {
      "control_mode": "gamepad",
      "image_preprocessing": {
        "crop_params_dict": {},
        "resize_size": [
          128,
          128
        ]
      },
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": 0.0
      },
      "reset": {
        "reset_time_s": 5.0,
        "control_time_s": 3600,
        "terminate_on_success": false
      },
      "inverse_kinematics": {
        "urdf_path": "../work/SO-ARM100/Simulation/SO101/so101_new_calib.urdf",
        "target_frame_name": "gripper",
        "end_effector_bounds": {
          "min": [
            0.1355,
            0.0156,
            0.0421
          ],
          "max": [
            0.1555,
            0.0356,
            0.0621
          ]
        },
        "end_effector_step_sizes": {
          "x": 0.003,
          "y": 0.003,
          "z": 0.003
        }
      },
      "observation": {
        "display_cameras": true
      }
    }
  },
  "dataset": {
    "repo_id": "local/so101_cube_lift_trial2",
    "root": "data/so101_cube_lift_trial2",
    "task": "pick up the cube and lift it",
    "num_episodes_to_record": 100,
    "replay_episode": null,
    "push_to_hub": false
  },
  "mode": null,
  "device": "cpu"
}
